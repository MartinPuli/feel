# Copy to chalk/.env (git-ignored) and fill in. Never commit the real file.
# Model Gateway API key: Chalk dashboard -> Model Gateway -> Access -> API keys. Shown once.
CHALK_ROUTER_API_KEY=
# Environment ID that the gateway routes to (sent as the X-Chalk-Env-Id header).
CHALK_ENV_ID=
# A vision-capable model from your gateway connections, e.g. anthropic/<model> or openai/<model>.
# List them with: chalk router model list
FEEL_CHALK_MODEL=
# Only change for a dedicated Chalk deployment.
CHALK_API_HOST=https://api.chalk.ai
# Service token scoped to the same environment (Chalk dashboard -> Settings -> Access Tokens): context queries
# (python -m feel_chalk.context) and hosted evaluations. Not needed for the gateway alone.
CHALK_CLIENT_ID=
CHALK_CLIENT_SECRET=
# Supabase project API address and publishable (anon) key: for the phone, which writes confirmed finds under
# row-level security. Chalk does not use them; it reads the database behind this project as the "feel_finds"
# PostgreSQL data source configured in the Chalk dashboard (see feel_context/README.md).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
