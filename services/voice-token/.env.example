# Server only. Never put this key in the iOS app.
OPENAI_API_KEY=
# Generate a separate random token with at least 32 characters for this demo phone.
FEEL_VOICE_ACCESS_TOKEN=
PORT=8081
# true requires a local TLS reverse proxy to overwrite X-Forwarded-Proto with https.
REQUIRE_HTTPS=false

# Explicitly opt into signed-in voice + durable context admission only after the
# selected FEEL database RPC/policies and matching phone build are verified.
# Default demo preserves the existing provisioned access-code flow.
FEEL_VOICE_AUTH_MODE=demo
# Production-only values: all credentials stay on this server. Never copy the
# secret/service-role key into iOS, a public bundle, a command argument or Git.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy server-only alternative to SUPABASE_SECRET_KEY:
SUPABASE_SERVICE_ROLE_KEY=
# Optional context route (separate from OpenAI voice):
CHALK_CLIENT_ID=
CHALK_CLIENT_SECRET=
CHALK_ENV_ID=
CHALK_CONTEXT_ENGINE_ORIGIN=
# Comma-separated reviewed shared room keys. Empty keeps all rooms disabled.
CHALK_CONTEXT_ROOMS=
